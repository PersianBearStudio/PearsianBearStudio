---
/**
 * PersianBearStudio — Home page
 * --------------------------------
 * Single-page editorial site. All sections rendered in a fixed order
 * so anchor navigation always resolves.
 *
 * Heading hierarchy:
 *   - h1: Hero (one per page)
 *   - h2: Each major section
 *   - h3: Items inside sections (principles, capabilities, stages, etc.)
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Studio from '../components/Studio.astro';
import Philosophy from '../components/Philosophy.astro';
import Capabilities from '../components/Capabilities.astro';
import Approach from '../components/Approach.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <Studio />
    <Philosophy />
    <Capabilities />
    <Approach />
    <Contact />
  </main>
  <Footer />
</Layout>
