---
/**
 * Base layout for PersianBearStudio pages.
 * Handles language/direction, fonts (Vazirmatn for Persian), and the
 * page chrome shared by the EN and FA pages.
 */
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import type { SupportedLang } from '../lib/types';

interface Props {
  lang: SupportedLang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const otherLangHref = lang === 'fa' ? '/' : '/fa';
const otherLangLabel = lang === 'fa' ? 'English' : 'فارسی';
const brandName = lang === 'fa' ? 'پرشین بیر استودیو' : 'PersianBearStudio';
const tagline =
  lang === 'fa'
    ? 'طراحی و توسعه وب‌سایت برای کسب‌وکارهای جدی'
    : 'Website design & development for serious businesses';
const contactEmail = 'persianbearstudio@gmail.com';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={lang === 'fa' ? '/fa' : '/'} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="fa" href="/fa" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="brand" href={lang === 'fa' ? '/fa' : '/'}>
            <svg
              class="brand-mark"
              viewBox="0 0 32 32"
              width="28"
              height="28"
              aria-hidden="true"
            >
              <circle cx="16" cy="16" r="16" fill="#e8a33d"></circle>
              <ellipse cx="16" cy="20" rx="6" ry="5" fill="#241f19"></ellipse>
              <circle cx="9.5" cy="12.5" r="2.6" fill="#241f19"></circle>
              <circle cx="16" cy="9.5" r="2.6" fill="#241f19"></circle>
              <circle cx="22.5" cy="12.5" r="2.6" fill="#241f19"></circle>
            </svg>
            <span class="brand-text">
              <span class="brand-name">{brandName}</span>
              <span class="brand-tagline">{tagline}</span>
            </span>
          </a>
          <a class="lang-switch" href={otherLangHref} hreflang={lang === 'fa' ? 'en' : 'fa'}>
            {otherLangLabel}
          </a>
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p>
            {brandName}
            ·
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .site-main {
    flex: 1;
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    padding: 40px 20px 72px;
  }
</style>
