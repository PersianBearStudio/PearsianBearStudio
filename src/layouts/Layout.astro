---
/**
 * Layout — Document shell shared by every page.
 *
 *  - English-language document.
 *  - Self-hosted Manrope variable font via @fontsource-variable.
 *  - Design tokens, global styles, motion system (CSS-first).
 *  - Comprehensive SEO metadata (title, description, OG, Twitter, canonical).
 *  - Conditional scroll-progress bar based on config.decorative.scrollProgress.
 *  - Conditional cursor-accent based on config.decorative.cursorAccent.
 *  - Skip link for keyboard users.
 *  - Sets `has-js` / `is-fine-pointer` / `prefers-reduced-motion` flags
 *    on <html> as early as possible to avoid FOUC.
 */
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import { studioConfig } from '../config/studio';

export interface Props {
  title?: string;
  description?: string;
  /** Path relative to site root, e.g. "/blog/foo". Defaults to "/". */
  path?: string;
}

const {
  title = `${studioConfig.brandName} — ${studioConfig.primaryTagline.join(' ')}`,
  description = studioConfig.metaDescription,
  path = '/',
} = Astro.props;

const canonical = new URL(path, studioConfig.canonicalUrl).href;
const ogImageUrl = new URL('/og-image.svg', studioConfig.canonicalUrl).href;
const faviconUrl = new URL('/favicon.svg', studioConfig.canonicalUrl).href;

// Inline early-flags script: runs before paint so initial state is correct.
const earlyFlags = `
  (function () {
    try {
      var d = document.documentElement;
      d.classList.add('has-js');
      if (window.matchMedia('(pointer: fine)').matches) {
        d.classList.add('is-fine-pointer');
      }
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var onReduce = function () {
        if (reduce.matches) { d.classList.remove('has-motion'); }
        else { d.classList.add('has-motion'); }
      };
      onReduce();
      reduce.addEventListener('change', onReduce);
    } catch (e) {}
  })();
`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101114" />
    <meta name="color-scheme" content="dark" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <link rel="mask-icon" href={faviconUrl} color="#F07835" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studioConfig.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Early feature flags (must run before paint) -->
    <script is:inline set:html={earlyFlags} />
  </head>
  <body>
    <a href="#studio" class="skip-link">Skip to content</a>

    {
      studioConfig.decorative.scrollProgress && (
        <div class="scroll-progress" data-scroll-progress aria-hidden="true" />
      )
    }

    {
      studioConfig.decorative.cursorAccent && (
        <div class="cursor-accent" data-cursor-accent aria-hidden="true" />
      )
    }

    <slot />

    <!-- Motion system (deferred; never blocks rendering) -->
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
