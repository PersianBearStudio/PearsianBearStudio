---
/**
 * Philosophy — Three principles that guide the studio.
 *
 *  - Minimalist editorial layout.
 *  - Animated dividers (orange fill grows on hover).
 *  - Understated typography with hover interaction.
 *  - Numbered principles (01, 02, 03).
 *  - All text bilingual via <I18n>.
 */
import I18n from './I18n.astro';

const principles = [
  { num: '01', titleKey: 'principle1Title', bodyKey: 'principle1Body' },
  { num: '02', titleKey: 'principle2Title', bodyKey: 'principle2Body' },
  { num: '03', titleKey: 'principle3Title', bodyKey: 'principle3Body' },
] as const;
---

<section class="section philosophy" id="philosophy" aria-labelledby="philosophy-heading">
  <div class="container">
    <header class="philosophy-header" data-reveal>
      <p class="eyebrow"><I18n k="philosophyEyebrow" /></p>
      <h2 class="philosophy-heading" id="philosophy-heading">
        <I18n k="philosophyHeading" />
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="philosophy-sub">
        <I18n k="philosophySub" />
      </p>
    </header>

    <ol class="principles" data-reveal-stagger>
      {
        principles.map((p, i) => (
          <li class="principle" data-reveal style={`--stagger-index: ${i};`}>
            <div class="principle-top">
              <span class="index-num principle-num">{p.num}</span>
              <span class="principle-divider" aria-hidden="true"></span>
            </div>
            <h3 class="principle-title"><I18n k={p.titleKey} /></h3>
            <p class="principle-body"><I18n k={p.bodyKey} /></p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .philosophy-header {
    max-width: 50ch;
    margin-block-end: var(--space-16);
  }

  .philosophy-heading {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin-block-start: var(--space-4);
  }

  .philosophy-sub {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 800px) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
    }
  }

  .principle {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-4);
  }

  .principle-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-block-end: var(--space-6);
  }

  .principle-num {
    flex-shrink: 0;
  }

  .principle-divider {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .principle-divider::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .principle:hover .principle-divider::after,
  .principle:focus-within .principle-divider::after {
    transform: scaleX(1);
  }

  .principle-title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    transition: color var(--duration-base) var(--ease-out);
    margin-block-end: var(--space-4);
  }

  .principle:hover .principle-title {
    color: var(--color-accent);
  }

  .principle-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 36ch;
  }
</style>
