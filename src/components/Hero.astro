---
/**
 * Hero — Studio introduction.
 *
 *  - Oversized editorial headline ("GOOD IDEAS. / PRECEISE EXECUTION.")
 *  - Staggered line-by-line reveal animation.
 *  - Animated brand mark composition on the right.
 *  - Primary + secondary CTAs.
 *  - Subtle grid background, parallax mark, orange accent line.
 *  - No fake stats, client logos, achievements, or project previews.
 *  - All visible text is bilingual via <I18n>.
 */
import BrandMark from './BrandMark.astro';
import I18n from './I18n.astro';
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow hero-eyebrow" data-reveal>
        <I18n k="heroEyebrow" />
      </p>

      <h1 class="hero-headline" id="hero-heading">
        <span class="hero-line" style="--hero-delay: 120ms;">
          <I18n k="heroLine1" />
        </span>
        <span class="hero-line" style="--hero-delay: 260ms;">
          <I18n k="heroLine2" />
        </span>
      </h1>

      <p class="hero-supporting" data-reveal style="--reveal-delay: 600ms;">
        <I18n k="heroSupporting" />
      </p>

      <p class="hero-paragraph" data-reveal style="--reveal-delay: 720ms;">
        <I18n k="heroParagraph" />
      </p>

      <div class="hero-actions" data-reveal style="--reveal-delay: 840ms;">
        <a
          href="#studio"
          class="btn btn-primary magnetic"
          data-magnetic
        >
          <I18n k="heroCtaPrimary" />
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a
          href="#contact"
          class="btn btn-secondary"
        >
          <I18n k="heroCtaSecondary" />
        </a>
      </div>
    </div>

    <div class="hero-mark parallax-target" data-parallax aria-hidden="true">
      <div class="hero-mark-frame">
        <BrandMark size={320} animated={true} loading="eager" />
        <span class="hero-mark-accent"></span>
        <span class="hero-mark-corner hero-mark-corner--tl"></span>
        <span class="hero-mark-corner hero-mark-corner--tr"></span>
        <span class="hero-mark-corner hero-mark-corner--bl"></span>
        <span class="hero-mark-corner hero-mark-corner--br"></span>
      </div>
      <p class="hero-mark-caption">
        <span class="accent">PBS</span>
        <span class="hero-mark-divider"></span>
        <I18n k="heroMarkCaption" />
      </p>
    </div>
  </div>

  <a href="#studio" class="hero-scroll-hint" aria-label="Scroll to studio">
    <span class="hero-scroll-hint-label"><I18n k="heroScrollHint" /></span>
    <span class="hero-scroll-hint-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    padding-block-start: calc(var(--header-height) + var(--space-12));
    padding-block-end: var(--space-20);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-16);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 60ch;
  }

  .hero-eyebrow {
    margin-block-end: var(--space-2);
  }

  .hero-headline {
    font-size: var(--text-5xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .hero-line {
    display: block;
  }

  .hero-line:nth-child(2) span {
    color: var(--color-text-primary);
  }

  .hero-line:nth-child(2) span::first-letter {
    color: var(--color-accent);
  }

  .hero-supporting {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    max-width: 30ch;
  }

  .hero-paragraph {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn:hover .btn-arrow,
  .btn:focus-visible .btn-arrow {
    transform: translateX(4px);
  }

  /* ---- Brand mark composition --------------------------------- */
  .hero-mark {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
    margin-block-start: var(--space-8);
  }

  .hero-mark-frame {
    position: relative;
    width: min(360px, 60vw);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    /* Let the brand image carry the dark background; the elevated
       surface tone is just for the surrounding frame edges. */
    background: var(--color-bg);
    /* Subtle accent glow behind the brand mark to tie it to the page accent. */
    box-shadow:
      0 0 0 1px rgba(240, 120, 53, 0.04) inset,
      0 24px 60px -40px rgba(240, 120, 53, 0.25);
  }

  /* The brand mark image fills the frame, clipped to the rounded rect.
     `object-fit: contain` keeps the entire mark visible; the small
     letterboxing (image is 378x409, frame is square) is negligible. */
  .hero-mark-frame :global(.brand-mark) {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
  }

  .hero-mark-accent {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    transform: translateX(-50%) translateY(-100%);
  }

  .hero-mark-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--color-accent);
    border-style: solid;
    border-width: 0;
  }
  .hero-mark-corner--tl {
    top: -1px; left: -1px;
    border-top-width: 1px; border-left-width: 1px;
  }
  .hero-mark-corner--tr {
    top: -1px; right: -1px;
    border-top-width: 1px; border-right-width: 1px;
  }
  .hero-mark-corner--bl {
    bottom: -1px; left: -1px;
    border-bottom-width: 1px; border-left-width: 1px;
  }
  .hero-mark-corner--br {
    bottom: -1px; right: -1px;
    border-bottom-width: 1px; border-right-width: 1px;
  }

  .hero-mark-caption {
    margin-block-start: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .hero-mark-divider {
    width: 16px;
    height: 1px;
    background: var(--color-border);
  }

  /* ---- Scroll hint ------------------------------------------- */
  .hero-scroll-hint {
    position: absolute;
    inset-block-end: var(--space-8);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    transition: color var(--duration-base) var(--ease-out);
  }

  .hero-scroll-hint:hover,
  .hero-scroll-hint:focus-visible {
    color: var(--color-accent);
  }

  .hero-scroll-hint-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    position: relative;
    overflow: hidden;
  }

  .hero-scroll-hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: translateY(-100%);
    animation: scroll-hint 1.8s var(--ease-in-out) infinite;
  }

  @keyframes scroll-hint {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-hint-line::after { animation: none; display: none; }
  }

  @media (max-width: 899px) {
    .hero-scroll-hint { display: none; }
  }

  /* Mobile: smaller headline */
  @media (max-width: 599px) {
    .hero-headline {
      font-size: clamp(2.5rem, 11vw, 4rem);
    }
    .hero-mark-frame {
      width: min(280px, 70vw);
    }
  }

  @media (max-width: 899px) {
    .hero-mark {
      order: -1;
      margin-block-start: 0;
    }
  }
</style>
