---
/**
 * LanguageSwitcher — Tab-style EN / فا language toggle.
 *
 *   - Compact, accessible (aria-pressed, role="tablist"), keyboard-friendly.
 *   - Two states only: EN and FA. Adding a third language requires extending
 *     LANGUAGES in src/config/translations.ts and the matching CSS rules in
 *     global.css.
 *   - Persists the choice to localStorage (key: `pbs-lang`).
 *   - No flash-of-wrong-language: Layout.astro has an inline script that
 *     reads localStorage pre-paint and sets <html lang/dir> before this
 *     component even mounts.
 *
 * Hidden on tiny screens by default (the mobile menu has its own switcher
 * placement); visible on tablet+ in the header.
 */
import { LANGUAGES, type Language } from '../config/translations';
---

<div class="lang-switch" role="tablist" aria-label="Language" data-lang-switch>
  {
    LANGUAGES.map((lang) => (
      <button
        type="button"
        role="tab"
        class="lang-tab"
        data-lang={lang.code}
        aria-pressed="false"
        aria-label={lang.code === 'en' ? 'English' : 'فارسی'}
        title={lang.code === 'en' ? 'English' : 'فارسی'}
      >
        {lang.label}
      </button>
    ))
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-hover);
    line-height: 1;
  }

  .lang-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 26px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .lang-tab:hover {
    color: var(--color-text-primary);
  }

  .lang-tab[aria-pressed='true'] {
    color: var(--color-bg);
    background-color: var(--color-accent);
  }

  /* On very small screens, hide the switcher from the header itself — it
     appears inside the mobile menu instead (handled by Header.astro). */
  @media (max-width: 540px) {
    .lang-switch {
      display: none;
    }
  }
</style>

<script>
  /**
   * Language switch behaviour.
   *   - Toggle <html lang> + <html dir>
   *   - Update all [aria-pressed] state on .lang-tab elements
   *   - Persist choice to localStorage
   *
   * The CSS in global.css handles showing/hiding .i18n-en / .i18n-fa
   * based on the <html lang> attribute, so no DOM text swap is needed.
   */
  import { LANGUAGES, getStoredLanguage, storeLanguage, type Language } from '../config/translations';

  function initLangSwitch() {
    const switches = Array.from(
      document.querySelectorAll<HTMLElement>('[data-lang-switch]')
    );
    if (switches.length === 0) return;

    const current = getStoredLanguage();

    // Sync every switch's tab state to the current language.
    const sync = (lang: Language) => {
      switches.forEach((sw) => {
        const tabs = Array.from(sw.querySelectorAll<HTMLButtonElement>('.lang-tab'));
        tabs.forEach((tab) => {
          const code = tab.getAttribute('data-lang') as Language;
          tab.setAttribute('aria-pressed', String(code === lang));
        });
      });
    };

    sync(current);

    // Wire up click handlers — any switch updates all switches.
    switches.forEach((sw) => {
      const tabs = Array.from(sw.querySelectorAll<HTMLButtonElement>('.lang-tab'));
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const code = tab.getAttribute('data-lang') as Language;
          if (!code) return;
          // Update <html lang> + <html dir>
          const meta = LANGUAGES.find((l) => l.code === code);
          if (!meta) return;
          const html = document.documentElement;
          html.setAttribute('lang', code);
          html.setAttribute('dir', meta.dir);
          storeLanguage(code);
          sync(code);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLangSwitch);
  } else {
    initLangSwitch();
  }
</script>
