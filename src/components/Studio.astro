---
/**
 * Studio — Editorial introduction to PersianBearStudio as a studio,
 * not as a group of individually profiled people.
 *
 *  - Eyebrow + heading "BUILT WITH INTENTION." / "با نیت درست ساخته می‌شود."
 *  - One paragraph of editorial copy (both EN + FA via <I18n>).
 *  - Sub-feature rows describing the studio's approach values.
 *  - Scroll-triggered reveals.
 *  - No team profiles, founder bios, or profile cards.
 */
import I18n from './I18n.astro';

const studioValues = [
  { titleKey: 'studioValue1Title', bodyKey: 'studioValue1Body' },
  { titleKey: 'studioValue2Title', bodyKey: 'studioValue2Body' },
  { titleKey: 'studioValue3Title', bodyKey: 'studioValue3Body' },
  { titleKey: 'studioValue4Title', bodyKey: 'studioValue4Body' },
  { titleKey: 'studioValue5Title', bodyKey: 'studioValue5Body' },
] as const;
---

<section class="section studio" id="studio" aria-labelledby="studio-heading">
  <div class="container studio-inner">
    <div class="studio-intro">
      <p class="eyebrow" data-reveal>
        <I18n k="studioEyebrow" />
      </p>
      <h2 class="studio-heading" id="studio-heading" data-reveal style="--reveal-delay: 80ms;">
        <I18n k="studioHeading" />
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="studio-lead" data-reveal style="--reveal-delay: 160ms;">
        <I18n k="studioLead" />
      </p>
    </div>

    <ol class="studio-values" data-reveal-stagger>
      {
        studioValues.map((item, i) => (
          <li class="studio-value" data-reveal style={`--stagger-index: ${i};`}>
            <div class="studio-value-index">
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="studio-value-body">
              <h3 class="studio-value-title"><I18n k={item.titleKey} /></h3>
              <p class="studio-value-text"><I18n k={item.bodyKey} /></p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .studio-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (min-width: 900px) {
    .studio-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-20);
    }
  }

  .studio-intro {
    position: sticky;
    top: calc(var(--header-height) + var(--space-8));
  }

  @media (max-width: 899px) {
    .studio-intro {
      position: static;
    }
  }

  .studio-heading {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin-block: var(--space-4) var(--space-2);
    max-width: 14ch;
  }

  .studio-lead {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 42ch;
    margin-block-start: var(--space-6);
  }

  .studio-values {
    display: flex;
    flex-direction: column;
    counter-reset: studio;
  }

  .studio-value {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    position: relative;
    transition: padding-inline-start var(--duration-base) var(--ease-out);
  }

  .studio-value:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .studio-value::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    height: 1px;
    width: 0;
    background: var(--color-accent);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .studio-value:hover::before {
    width: 100%;
  }

  .studio-value:hover {
    padding-inline-start: var(--space-4);
  }

  .studio-value-index {
    font-feature-settings: 'tnum';
  }

  .studio-value-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    margin-block-end: var(--space-3);
    color: var(--color-text-primary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .studio-value:hover .studio-value-title {
    color: var(--color-accent);
  }

  .studio-value-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 50ch;
  }

  @media (max-width: 599px) {
    .studio-value {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
