---
/**
 * SocialIcon — Inline SVG icons for contact methods.
 * Renders a 20x20 icon by default. Inherits `currentColor`.
 *
 * Pass `key` from a `SocialLink`. Unknown keys render a generic link icon.
 * Special keys:
 *   - 'telegram'        — paper-plane (used for Telegram bot)
 *   - 'telegram-channel' — megaphone (used for Telegram channel/broadcast)
 *   - 'instagram'        — square-with-circle (Instagram logo)
 */
export interface Props {
  /** Matches `SocialLink['key']` in src/config/studio.ts */
  key: 'email' | 'github' | 'telegram' | 'telegram-channel' | 'linkedin' | 'twitter' | 'instagram' | string;
  size?: number;
  class?: string;
}

const { key, size = 20, class: className = '' } = Astro.props;
---

{
  key === 'email' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M4 7l8 6 8-6" />
    </svg>
  )
}

{
  key === 'github' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.42 9.42 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
    </svg>
  )
}

{
  key === 'telegram' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M21.94 4.55 18.6 20.06c-.25 1.11-.91 1.38-1.85.86l-5.12-3.78-2.47 2.38c-.27.27-.5.5-1 .5l.36-5.18 9.5-8.58c.41-.37-.09-.57-.64-.21l-11.74 7.4-5.06-1.58c-1.1-.34-1.12-1.1.23-1.62l19.79-7.63c.92-.34 1.72.21 1.42 1.53Z" />
    </svg>
  )
}

{
  key === 'telegram-channel' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {/* Megaphone / broadcast channel — visually distinct from the bot's
          paper plane so users can tell at a glance which Telegram entry is
          the bot vs. the channel. */}
      <path d="M3 11v2a1 1 0 0 0 1 1h2l3 4h2l-2-4h2l8 3V8l-8 3H6a3 3 0 0 0-3 3Z" />
      <path d="M14 11v3" />
      <path d="M17 9c1 .5 1.5 1.5 1.5 3s-.5 2.5-1.5 3" />
    </svg>
  )
}

{
  key === 'linkedin' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6 1.12 6 0 4.88 0 3.5 0 2.12 1.12 1 2.49 1c1.37 0 2.49 1.12 2.49 2.5ZM.21 8h4.55v14H.21V8Zm7.59 0h4.36v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.55v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.53 1.72-2.53 3.49V22H7.8V8Z" />
    </svg>
  )
}

{
  key === 'twitter' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M18.9 5.5h2.66l-5.81 6.64L22.5 19.5h-5.36l-4.2-5.5-4.81 5.5H5.46l6.21-7.1L4.5 5.5h5.49l3.79 5.01L18.9 5.5Zm-.94 12.5h1.48L8.6 6.94H7.01L17.96 18Z" />
    </svg>
  )
}

{
  key === 'instagram' && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  !['email', 'github', 'telegram', 'telegram-channel', 'linkedin', 'twitter', 'instagram'].includes(key) && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M10 13a5 5 0 0 0 7.07 0l2-2A5 5 0 0 0 13 4l-1 1" />
      <path d="M14 11a5 5 0 0 0-7.07 0l-2 2A5 5 0 0 0 11 20l1-1" />
    </svg>
  )
}
