---
/**
 * Capabilities — Studio's web development focus, presented as an editorial list.
 *
 *  - No oversized service cards (per spec).
 *  - Clean editorial list with hover treatment (accent underline grows,
 *    title shifts color, an arrow appears).
 *  - Items are pulled from `translations.ts` so editing the translations
 *    updates the section in both languages.
 *  - No invented certifications, expertise levels, or completed work.
 *  - All text bilingual via <I18n>.
 */
import I18n from './I18n.astro';

const capabilities = [
  { titleKey: 'capability1Title', bodyKey: 'capability1Body' },
  { titleKey: 'capability2Title', bodyKey: 'capability2Body' },
  { titleKey: 'capability3Title', bodyKey: 'capability3Body' },
  { titleKey: 'capability4Title', bodyKey: 'capability4Body' },
  { titleKey: 'capability5Title', bodyKey: 'capability5Body' },
] as const;
---

<section class="section capabilities" id="capabilities" aria-labelledby="capabilities-heading">
  <div class="container">
    <header class="capabilities-header" data-reveal>
      <p class="eyebrow"><I18n k="capabilitiesEyebrow" /></p>
      <h2 class="capabilities-heading" id="capabilities-heading">
        <I18n k="capabilitiesHeading" />
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="capabilities-sub">
        <I18n k="capabilitiesSub" />
      </p>
    </header>

    <ol class="capability-list" data-reveal-stagger>
      {
        capabilities.map((cap, i) => (
          <li class="capability-item" data-reveal style={`--stagger-index: ${i};`}>
            <div class="capability-meta">
              <span class="index-num capability-index">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="capability-body">
              <h3 class="capability-title">
                <I18n k={cap.titleKey} />
                <span class="capability-arrow" aria-hidden="true">↗</span>
              </h3>
              <p class="capability-description"><I18n k={cap.bodyKey} /></p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .capabilities-header {
    max-width: 50ch;
    margin-block-end: var(--space-16);
  }

  .capabilities-heading {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin-block-start: var(--space-4);
  }

  .capabilities-sub {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .capability-list {
    display: flex;
    flex-direction: column;
  }

  .capability-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-6);
    padding-inline: var(--space-2);
    border-top: 1px solid var(--color-border);
    transition: padding-inline-start var(--duration-base) var(--ease-out);
    position: relative;
  }

  .capability-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .capability-item::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    height: 1px;
    width: 0;
    background: var(--color-accent);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .capability-item:hover::before,
  .capability-item:focus-within::before {
    width: 100%;
  }

  .capability-item:hover {
    padding-inline-start: var(--space-5);
  }

  .capability-index {
    color: var(--color-text-secondary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .capability-item:hover .capability-index,
  .capability-item:focus-within .capability-index {
    color: var(--color-accent);
  }

  .capability-title {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    transition: color var(--duration-base) var(--ease-out);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .capability-description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }

  @media (max-width: 599px) {
    .capability-item {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .capability-title {
      font-size: var(--text-xl);
    }
  }
</style>
