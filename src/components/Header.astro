---
/**
 * Header — Compact premium site header.
 *
 *  - Bear emblem + wordmark linking to top.
 *  - Desktop nav: Home, Studio, Philosophy, Capabilities, Contact.
 *  - Contact CTA (compact).
 *  - Hamburger on mobile → full-screen overlay with staggered links.
 *  - Scroll-aware: transparent at top, dark blurred surface after scrolling.
 *  - No team/portfolio/language-switch links (per spec).
 */
import Bear from './Bear.astro';
import { studioConfig, hasContact, configuredEmail } from '../config/studio';

const navItems = [
  { label: 'Home', href: '#top' },
  { label: 'Studio', href: '#studio' },
  { label: 'Philosophy', href: '#philosophy' },
  { label: 'Capabilities', href: '#capabilities' },
  { label: 'Contact', href: '#contact' },
];

const email = configuredEmail();
const showContactCta = hasContact();
---

<header class="site-header" id="site-header" data-header>
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label={`${studioConfig.brandName} — back to top`}>
      <Bear size={32} variant="bi-color" />
      <span class="wordmark">{studioConfig.wordmark}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-nav-link={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {
        showContactCta ? (
          <a
            href="#contact"
            class="header-cta"
            data-nav-link="#contact"
          >
            <span>Contact</span>
            <span class="header-cta-arrow" aria-hidden="true">→</span>
          </a>
        ) : null
      }

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay menu -->
<div
  class="mobile-menu"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  data-mobile-menu
  hidden
>
  <nav class="mobile-nav" aria-label="Mobile primary">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-menu-link"
              data-mobile-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mobile-menu-footer">
    <p class="mobile-tagline">{studioConfig.secondaryTagline}</p>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    width: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-primary);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    opacity: 0.8;
  }

  .wordmark {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-primary);
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .header-cta:hover {
    color: var(--color-bg);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .header-cta-arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .header-cta:hover .header-cta-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 900px) {
    .header-cta {
      display: inline-flex;
    }
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .menu-toggle:hover {
    color: var(--color-accent);
    background-color: var(--color-surface-hover);
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }
  }

  /* ---- Mobile menu ------------------------------------------------- */
  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu-footer {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .mobile-tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  /**
   * Header behaviour:
   *   - Scrolled-state surface
   *   - Mobile menu open/close + focus trap + ESC
   *   - Active nav link highlighting via IntersectionObserver
   */
  type HeaderState = {
    menuOpen: boolean;
    lastFocus: HTMLElement | null;
  };

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const mobileLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]')
    );
    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
    );

    if (!header || !toggle || !menu) return;

    const state: HeaderState = { menuOpen: false, lastFocus: null };

    // ---- Scrolled surface ----
    const onScroll = () => {
      if (window.scrollY > 8) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // ---- Mobile menu open/close ----
    const setMenu = (open: boolean) => {
      state.menuOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      const hamburger = toggle.querySelector('.hamburger');
      if (hamburger) {
        hamburger.classList.toggle('is-open', open);
      }
      if (open) {
        menu.hidden = false;
        // Force reflow so transition runs
        void menu.offsetWidth;
        menu.classList.add('is-open');
        state.lastFocus = document.activeElement as HTMLElement;
        document.body.style.overflow = 'hidden';
        // Focus first link after transition starts
        const first = mobileLinks[0];
        if (first) window.setTimeout(() => first.focus(), 120);
      } else {
        menu.classList.remove('is-open');
        document.body.style.overflow = '';
        // Wait for transition end before hiding (a11y)
        window.setTimeout(() => {
          if (!state.menuOpen) menu.hidden = true;
        }, 320);
        if (state.lastFocus) state.lastFocus.focus();
      }
    };

    toggle.addEventListener('click', () => setMenu(!state.menuOpen));

    // Close on link click
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && state.menuOpen) {
        setMenu(false);
      }
    });

    // Close on outside click (the overlay itself)
    menu.addEventListener('click', (e) => {
      if (e.target === menu) setMenu(false);
    });

    // Close on resize to desktop
    const mq = window.matchMedia('(min-width: 900px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && state.menuOpen) setMenu(false);
    });

    // ---- Active nav link via IntersectionObserver ----
    /** @type {{ link: HTMLAnchorElement; el: Element }[]} */
    const sections = [];
    navLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-link') ?? '';
      if (!href.startsWith('#')) return;
      const el = document.querySelector(href);
      if (el) sections.push({ link, el });
    });

    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const matched = sections.find((s) => s.el === entry.target);
            if (!matched) return;
            if (entry.isIntersecting) {
              navLinks.forEach((l) => l.classList.remove('is-active'));
              matched.link.classList.add('is-active');
            }
          });
        },
        {
          rootMargin: '-50% 0px -50% 0px',
          threshold: 0,
        }
      );
      sections.forEach((s) => observer.observe(s.el));
    }
  }

  // Run on initial DOMContentLoaded + after Astro view transitions (future-proof)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
