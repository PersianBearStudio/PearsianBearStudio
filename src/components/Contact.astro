---
/**
 * Contact — Bold final section inviting collaboration.
 *
 *  - Headline: "LET'S BUILD SOMETHING MEANINGFUL."
 *  - Supporting copy from config.
 *  - Configurable email / GitHub / Telegram / other links rendered only
 *    if they are configured in studio.ts. Missing links are omitted.
 *  - Copy-to-clipboard interaction only when a real mailto: email is set.
 *  - Subtle hover animations.
 *  - No invented emails / usernames / social accounts.
 */
import { studioConfig, configuredSocial, configuredEmail } from '../config/studio';
import SocialIcon from './SocialIcon.astro';

const social = configuredSocial();
const email = configuredEmail();

// Extract the bare email address (without mailto:) for the copy-to-clipboard interaction.
const emailAddress = email && email.url.startsWith('mailto:')
  ? email.url.replace(/^mailto:/, '')
  : email?.url ?? '';
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="container contact-inner">
    <div class="contact-lead" data-reveal>
      <p class="eyebrow"><span>Contact</span></p>
      <h2 class="contact-heading" id="contact-heading">
        {studioConfig.contactHeading}
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="contact-copy">{studioConfig.contactCopy}</p>
    </div>

    <div class="contact-actions" data-reveal style="--reveal-delay: 160ms;">
      {
        email && (
          <div class="contact-email-block">
            <span class="contact-label">Email</span>
            <div class="contact-email-row">
              <a href={email.url} class="contact-email">
                {emailAddress || email.label}
              </a>
              {emailAddress && (
                <button
                  type="button"
                  class="copy-button"
                  data-copy-target={emailAddress}
                  aria-label={`Copy email address ${emailAddress} to clipboard`}
                >
                  <span class="copy-label">Copy</span>
                  <span class="copy-done" aria-hidden="true">Copied</span>
                </button>
              )}
            </div>
          </div>
        )
      }

      {
        social.length > 0 && (
          <ul class="contact-links">
            {
              social
                .filter((s) => s.key !== 'email')
                .map((s) => (
                  <li>
                    <a
                      href={s.url}
                      class="contact-link"
                      rel="noopener noreferrer"
                      target={s.url.startsWith('mailto:') ? '_self' : '_blank'}
                    >
                      <SocialIcon key={s.key} size={18} />
                      <span>{s.label}</span>
                      <span class="contact-link-arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))
            }
          </ul>
        )
      }

      {
        social.length === 0 && (
          <p class="contact-empty">
            <span class="contact-empty-line"></span>
            Contact channels will appear here once configured.
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-bg);
    position: relative;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: end;
  }

  @media (min-width: 900px) {
    .contact-inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }

  .contact-heading {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    line-height: 0.95;
    margin-block-start: var(--space-5);
    max-width: 18ch;
  }

  .contact-copy {
    margin-block-start: var(--space-6);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
  }

  .contact-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-block-end: var(--space-3);
  }

  .contact-email-block {
    border-top: 1px solid var(--color-border);
    padding-block-start: var(--space-6);
  }

  .contact-email-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .contact-email {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .copy-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .copy-done {
    display: none;
  }

  .copy-button.is-copied .copy-label {
    display: none;
  }

  .copy-button.is-copied .copy-done {
    display: inline;
  }

  .contact-links {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--color-text-primary);
    font-size: var(--text-md);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-accent);
  }

  .contact-link-arrow {
    margin-inline-start: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
    color: var(--color-accent);
  }

  .contact-link:hover .contact-link-arrow,
  .contact-link:focus-visible .contact-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .contact-empty {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact-empty-line {
    width: 24px;
    height: 1px;
    background: var(--color-border);
  }

  @media (max-width: 899px) {
    .contact-email {
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  /**
   * Copy-to-clipboard for the configured email address.
   * Gracefully degrades when the Clipboard API is unavailable.
   */
  function initCopy() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');

    buttons.forEach((btn) => {
      const target = btn.getAttribute('data-copy-target') ?? '';
      if (!target) return;

      btn.addEventListener('click', async () => {
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(target);
          } else {
            // Fallback: execCommand
            const ta = document.createElement('textarea');
            ta.value = target;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          btn.classList.add('is-copied');
          const reset = () => btn.classList.remove('is-copied');
          window.setTimeout(reset, 1800);
          btn.addEventListener('blur', reset, { once: true });
        } catch (err) {
          // Silent fail; the user can still select the address manually.
          // eslint-disable-next-line no-console
          console.warn('Clipboard copy failed:', err);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopy);
  } else {
    initCopy();
  }
</script>
