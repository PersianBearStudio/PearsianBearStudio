---
/**
 * Contact — Bold final section inviting collaboration.
 *
 *  - Project inquiry form with server-confirmed delivery.
 *  - Required fields are validated in the browser and again in the Worker.
 *  - Missing delivery configuration never produces a fake success state.
 *  - Configured email / Telegram / Instagram / other links remain available
 *    as direct contact alternatives.
 *
 * Social link labels are localized by mapping the `key` from studio.ts
 * (e.g. 'telegram') to the matching <I18n> key (e.g. 'socialTelegramLabel').
 */
import { configuredSocial, configuredEmail } from '../config/studio';
import { INQUIRY_LIMITS, INQUIRY_PROJECT_TYPES } from '../lib/inquiry';
import SocialIcon from './SocialIcon.astro';
import I18n from './I18n.astro';

const social = configuredSocial();
const email = configuredEmail();

// Extract the bare email address (without mailto:) for the copy-to-clipboard interaction.
const emailAddress = email && email.url.startsWith('mailto:')
  ? email.url.replace(/^mailto:/, '')
  : email?.url ?? '';

// Map social `key` → translation key for the localized label.
const SOCIAL_LABEL_KEY: Record<string, 'socialTelegramLabel' | 'socialInstagramLabel' | 'socialEmailLabel' | 'socialGithubLabel' | 'socialLinkedinLabel' | 'socialTwitterLabel'> = {
  telegram: 'socialTelegramLabel',
  instagram: 'socialInstagramLabel',
  email: 'socialEmailLabel',
  github: 'socialGithubLabel',
  linkedin: 'socialLinkedinLabel',
  twitter: 'socialTwitterLabel',
};
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="container contact-inner">
    <div class="contact-lead" data-reveal>
      <p class="eyebrow"><I18n k="contactEyebrow" /></p>
      <h2 class="contact-heading" id="contact-heading">
        <I18n k="contactHeading" />
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="contact-copy"><I18n k="contactCopy" /></p>
      <div class="contact-cta-row">
        <a class="contact-cta contact-cta-primary" href="#inquiry-form">Start a Project <span aria-hidden="true">↓</span></a>
        {email && <a class="contact-cta contact-cta-secondary" href={email.url}>Email Us <span aria-hidden="true">↗</span></a>}
      </div>
    </div>

    <div class="contact-actions" data-reveal style="--reveal-delay: 160ms;">
      <form class="inquiry-form" id="inquiry-form" data-inquiry-form novalidate>
        <div class="inquiry-form-heading">
          <span class="contact-label">Project inquiry</span>
          <p class="inquiry-form-intro">Share the essentials and we’ll reply with the right next step.</p>
        </div>

        <div class="inquiry-fields">
          <label class="inquiry-field">
            <span class="inquiry-label">Full name <span aria-hidden="true">*</span></span>
            <input name="fullName" type="text" required maxlength={INQUIRY_LIMITS.fullName} autocomplete="name" placeholder="Your name" aria-describedby="inquiry-error-fullName" />
            <span class="inquiry-error" id="inquiry-error-fullName" data-error-for="fullName"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Email <span aria-hidden="true">*</span></span>
            <input name="email" type="email" required maxlength={INQUIRY_LIMITS.email} autocomplete="email" placeholder="you@example.com" aria-describedby="inquiry-error-email" />
            <span class="inquiry-error" id="inquiry-error-email" data-error-for="email"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Project type <span aria-hidden="true">*</span></span>
            <select name="projectType" required aria-describedby="inquiry-error-projectType">
              <option value="">Choose one</option>
              {INQUIRY_PROJECT_TYPES.map((projectType) => <option value={projectType}>{projectType}</option>)}
            </select>
            <span class="inquiry-error" id="inquiry-error-projectType" data-error-for="projectType"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Company <span class="inquiry-optional">Optional</span></span>
            <input name="company" type="text" maxlength={INQUIRY_LIMITS.company} autocomplete="organization" placeholder="Company or brand name" aria-describedby="inquiry-error-company" />
            <span class="inquiry-error" id="inquiry-error-company" data-error-for="company"></span>
          </label>

          <label class="inquiry-field inquiry-field-wide">
            <span class="inquiry-label">Short description <span aria-hidden="true">*</span></span>
            <textarea name="shortDescription" required maxlength={INQUIRY_LIMITS.shortDescription} rows="3" placeholder="What would you like to build or improve?" aria-describedby="inquiry-error-shortDescription"></textarea>
            <span class="inquiry-error" id="inquiry-error-shortDescription" data-error-for="shortDescription"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Audience <span class="inquiry-optional">Optional</span></span>
            <input name="audience" type="text" maxlength={INQUIRY_LIMITS.audience} placeholder="Who is the site for?" aria-describedby="inquiry-error-audience" />
            <span class="inquiry-error" id="inquiry-error-audience" data-error-for="audience"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Current URL <span class="inquiry-optional">Optional</span></span>
            <input name="currentUrl" type="url" maxlength={INQUIRY_LIMITS.currentUrl} placeholder="https://" inputmode="url" aria-describedby="inquiry-error-currentUrl" />
            <span class="inquiry-error" id="inquiry-error-currentUrl" data-error-for="currentUrl"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Launch timeframe <span class="inquiry-optional">Optional</span></span>
            <input name="launchTimeframe" type="text" maxlength={INQUIRY_LIMITS.launchTimeframe} placeholder="e.g. This summer" aria-describedby="inquiry-error-launchTimeframe" />
            <span class="inquiry-error" id="inquiry-error-launchTimeframe" data-error-for="launchTimeframe"></span>
          </label>

          <label class="inquiry-field">
            <span class="inquiry-label">Budget <span class="inquiry-optional">Optional</span></span>
            <select name="budget" aria-describedby="inquiry-error-budget">
              <option value="">Not sure yet</option>
              <option value="Under $5,000">Under $5,000</option>
              <option value="$5,000–$10,000">$5,000–$10,000</option>
              <option value="$10,000–$25,000">$10,000–$25,000</option>
              <option value="$25,000+">$25,000+</option>
            </select>
            <span class="inquiry-error" id="inquiry-error-budget" data-error-for="budget"></span>
          </label>

          <label class="inquiry-field inquiry-field-wide">
            <span class="inquiry-label">Problem to solve <span class="inquiry-optional">Optional</span></span>
            <textarea name="problem" maxlength={INQUIRY_LIMITS.problem} rows="2" placeholder="What is not working today?" aria-describedby="inquiry-error-problem"></textarea>
            <span class="inquiry-error" id="inquiry-error-problem" data-error-for="problem"></span>
          </label>

          <label class="inquiry-field inquiry-field-wide">
            <span class="inquiry-label">Additional details <span class="inquiry-optional">Optional</span></span>
            <textarea name="additionalDetails" maxlength={INQUIRY_LIMITS.additionalDetails} rows="3" placeholder="Anything else that would help us understand the project?" aria-describedby="inquiry-error-additionalDetails"></textarea>
            <span class="inquiry-error" id="inquiry-error-additionalDetails" data-error-for="additionalDetails"></span>
          </label>

          <label class="inquiry-trap" aria-hidden="true">
            <span>Website</span>
            <input name="website" type="text" tabindex="-1" autocomplete="off" maxlength={INQUIRY_LIMITS.website} />
          </label>
        </div>

        <div class="inquiry-submit-row">
          <button class="inquiry-submit" type="submit" data-inquiry-submit>
            <span data-submit-label>Send inquiry</span>
            <span data-submit-loading hidden>Sending…</span>
            <span aria-hidden="true">↗</span>
          </button>
          <p class="inquiry-privacy">By submitting, you agree we may use these details to reply about your project. We do not use this form for marketing.</p>
        </div>
        <p class="inquiry-status" data-inquiry-status role="status" aria-live="polite"></p>
      </form>

      <div class="inquiry-success" data-inquiry-success hidden tabindex="-1">
        <span class="contact-label">Inquiry received</span>
        <h3>Thanks — we’ll be in touch.</h3>
        <p>Your project details reached the studio. We’ll review them and reply by email.</p>
      </div>

      {
        email && (
          <div class="contact-email-block">
            <span class="contact-label"><I18n k="contactEmailLabel" /></span>
            <div class="contact-email-row">
              <a href={email.url} class="contact-email">
                {emailAddress || email.label}
              </a>
              {emailAddress && (
                <button
                  type="button"
                  class="copy-button"
                  data-copy-target={emailAddress}
                  aria-label={`Copy email address ${emailAddress} to clipboard`}
                >
                  <span class="copy-label"><I18n k="contactCopyButton" /></span>
                  <span class="copy-done" aria-hidden="true"><I18n k="contactCopied" /></span>
                </button>
              )}
            </div>
          </div>
        )
      }

      {
        social.length > 0 && (
          <ul class="contact-links">
            {
              social
                .filter((s) => s.key !== 'email')
                .map((s) => {
                  const labelKey = SOCIAL_LABEL_KEY[s.key] ?? 'socialEmailLabel';
                  return (
                    <li>
                      <a
                        href={s.url}
                        class="contact-link"
                        rel="noopener noreferrer"
                        target={s.url.startsWith('mailto:') ? '_self' : '_blank'}
                      >
                        <SocialIcon key={s.key} size={18} />
                        <I18n k={labelKey} />
                        <span class="contact-link-arrow" aria-hidden="true">↗</span>
                      </a>
                    </li>
                  );
                })
            }
          </ul>
        )
      }

      {
        social.length === 0 && (
          <p class="contact-empty">
            <span class="contact-empty-line"></span>
            <I18n k="contactChannelsPlaceholder" />
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-bg);
    position: relative;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: end;
  }

  @media (min-width: 900px) {
    .contact-inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }

  .contact-heading {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    line-height: 0.95;
    margin-block-start: var(--space-5);
    max-width: 18ch;
  }

  .contact-copy {
    margin-block-start: var(--space-6);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
  }

  .contact-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .contact-cta-primary {
    color: #14110e;
    background: var(--gradient-accent);
    border-color: transparent;
  }

  .contact-cta-secondary {
    color: var(--color-text-primary);
    background: var(--color-surface);
  }

  .contact-cta:hover,
  .contact-cta:focus-visible {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .contact-cta-primary:hover,
  .contact-cta-primary:focus-visible {
    color: #14110e;
    filter: brightness(1.06) saturate(1.05);
  }

  .contact-cta-secondary:hover,
  .contact-cta-secondary:focus-visible {
    color: var(--color-accent-hover);
    background: var(--color-accent-soft);
  }

  .contact-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-block-end: var(--space-3);
  }

  .contact-email-block {
    border-top: 1px solid var(--color-border);
    padding-block-start: var(--space-6);
  }

  .contact-email-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .contact-email {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .copy-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .copy-done {
    display: none;
  }

  .copy-button.is-copied .copy-label {
    display: none;
  }

  .copy-button.is-copied .copy-done {
    display: inline;
  }

  .copy-button.is-copy-failed {
    color: var(--color-text-primary);
    background-color: transparent;
    border-color: var(--color-text-secondary);
  }

  .inquiry-form,
  .inquiry-success {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  .inquiry-form-heading {
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--color-border-soft);
  }

  .inquiry-form-intro {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 42ch;
  }

  .inquiry-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }

  .inquiry-field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .inquiry-field-wide {
    grid-column: 1 / -1;
  }

  .inquiry-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .inquiry-optional {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    letter-spacing: var(--tracking-tight);
    text-transform: none;
  }

  .inquiry-field input,
  .inquiry-field select,
  .inquiry-field textarea {
    width: 100%;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: rgba(16, 17, 20, 0.72);
    color: var(--color-text-primary);
    font: inherit;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    padding: 0.7rem 0.8rem;
    transition: border-color var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }

  .inquiry-field textarea {
    min-height: 5rem;
    resize: vertical;
  }

  .inquiry-field input::placeholder,
  .inquiry-field textarea::placeholder {
    color: var(--color-text-muted);
  }

  .inquiry-field input:hover,
  .inquiry-field select:hover,
  .inquiry-field textarea:hover,
  .inquiry-field input:focus,
  .inquiry-field select:focus,
  .inquiry-field textarea:focus {
    border-color: var(--color-accent-line);
    background-color: rgba(16, 17, 20, 0.96);
    outline: none;
  }

  .inquiry-field [aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  .inquiry-error {
    min-height: 1.1rem;
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
  }

  .inquiry-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .inquiry-submit-row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-block-start: var(--space-2);
  }

  .inquiry-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex: 0 0 auto;
    min-height: 2.9rem;
    padding: 0.75rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--gradient-accent);
    color: #14110e;
    font-size: var(--text-sm);
    font-weight: 650;
    box-shadow: var(--shadow-glow);
    transition: filter var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .inquiry-submit:hover,
  .inquiry-submit:focus-visible {
    filter: brightness(1.07) saturate(1.05);
  }

  .inquiry-submit:active {
    transform: scale(0.98);
  }

  .inquiry-submit:disabled {
    cursor: wait;
    opacity: 0.65;
    filter: grayscale(0.25);
  }

  .inquiry-privacy {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    max-width: 34ch;
  }

  .inquiry-status {
    min-height: 1.4rem;
    margin-block-start: var(--space-4);
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .inquiry-status a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.18em;
  }

  .inquiry-success h3 {
    margin-block-start: var(--space-3);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .inquiry-success p {
    margin-block-start: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .contact-links {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--color-text-primary);
    font-size: var(--text-md);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-accent);
  }

  .contact-link-arrow {
    margin-inline-start: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
    color: var(--color-accent);
  }

  .contact-link:hover .contact-link-arrow,
  .contact-link:focus-visible .contact-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .contact-empty {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact-empty-line {
    width: 24px;
    height: 1px;
    background: var(--color-border);
  }

  @media (max-width: 899px) {
    .contact-email {
      font-size: var(--text-lg);
    }

    .inquiry-submit-row {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .inquiry-privacy {
      max-width: none;
    }

    .contact-cta {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    .inquiry-form,
    .inquiry-success {
      padding: var(--space-5);
    }

    .inquiry-fields {
      grid-template-columns: 1fr;
    }

    .inquiry-field-wide {
      grid-column: auto;
    }
  }
</style>

<script>
  /**
   * Copy-to-clipboard for the configured email address.
   * Gracefully degrades when the Clipboard API is unavailable.
   * Surfaces success and failure both visually and to assistive tech
   * via an aria-live region (so screen readers announce the result).
   * Status messages are localized to the current <html lang>.
   */
  function initCopy() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');
    if (buttons.length === 0) return;

    // Build (or reuse) a single shared status region for announcements.
    let status = document.getElementById('copy-status');
    if (!status) {
      status = document.createElement('div');
      status.id = 'copy-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');
      // Visually hidden but available to assistive tech.
      status.style.cssText =
        'position:absolute;width:1px;height:1px;padding:0;margin:-1px;' +
        'overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;';
      document.body.appendChild(status);
    }

    // Localized status messages (mirrors translations.ts but inline so the
    // script doesn't need to import the JSON at runtime).
    const lang = () => (document.documentElement.getAttribute('lang') === 'fa' ? 'fa' : 'en');
    const statusOk = (addr: string) =>
      lang() === 'fa' ? `ایمیل کپی شد: ${addr}` : `Email address copied: ${addr}`;
    const statusFail = () =>
      lang() === 'fa'
        ? 'کپی ناموفق بود — می‌توانید به‌صورت دستی انتخاب کنید.'
        : 'Copy failed. You can still select the email address manually.';

    buttons.forEach((btn) => {
      const target = btn.getAttribute('data-copy-target') ?? '';
      if (!target) return;

      btn.addEventListener('click', async () => {
        let ok = false;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(target);
            ok = true;
          } else {
            // Fallback: execCommand
            const ta = document.createElement('textarea');
            ta.value = target;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            try {
              ta.select();
              ok = document.execCommand('copy');
            } finally {
              ta.remove();
            }
          }
        } catch (err) {
          ok = false;
          if (window.console && console.warn) {
            console.warn('Clipboard copy failed:', err);
          }
        }

        if (ok) {
          btn.classList.add('is-copied');
          status.textContent = statusOk(target);
          const reset = () => btn.classList.remove('is-copied');
          window.setTimeout(reset, 1800);
          btn.addEventListener('blur', reset, { once: true });
        } else {
          btn.classList.add('is-copy-failed');
          status.textContent = statusFail();
          const reset = () => btn.classList.remove('is-copy-failed');
          window.setTimeout(reset, 2400);
          btn.addEventListener('blur', reset, { once: true });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopy);
  } else {
    initCopy();
  }
</script>

<script>
  const inquiryForm = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  const inquirySuccess = document.querySelector<HTMLElement>('[data-inquiry-success]');
  const inquiryStatus = document.querySelector<HTMLElement>('[data-inquiry-status]');
  const inquirySubmit = document.querySelector<HTMLButtonElement>('[data-inquiry-submit]');
  const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
  const submitLoading = document.querySelector<HTMLElement>('[data-submit-loading]');

  if (inquiryForm && inquirySuccess && inquiryStatus && inquirySubmit && submitLabel && submitLoading) {
    const fields = Array.from(
      inquiryForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        '[name]:not([name="website"])',
      ),
    );
    let submitting = false;

    const errorFor = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) =>
      inquiryForm.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);

    const setFieldError = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string) => {
      const error = errorFor(field);
      field.toggleAttribute('aria-invalid', Boolean(message));
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
      if (error) error.textContent = message;
    };

    const validateField = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): string => {
      const value = field.value.trim();
      if (field.required && !value) return 'This field is required.';
      if (field.name === 'email' && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        return 'Please provide a valid email address.';
      }
      if (field.name === 'currentUrl' && value) {
        try {
          const url = new URL(value);
          if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new Error('unsupported protocol');
        } catch {
          return 'Please provide a valid http(s) URL.';
        }
      }
      return '';
    };

    fields.forEach((field) => {
      field.addEventListener('blur', () => setFieldError(field, validateField(field)));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') setFieldError(field, validateField(field));
      });
    });

    const showFailure = (message: string, fallbackEmail?: unknown) => {
      inquiryStatus.textContent = message;
      const safeEmail = typeof fallbackEmail === 'string' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fallbackEmail)
        ? fallbackEmail
        : 'persianbearstudio@gmail.com';
      const fallback = document.createElement('a');
      fallback.href = `mailto:${safeEmail}?subject=${encodeURIComponent('Project inquiry')}`;
      fallback.textContent = ` Email us directly at ${safeEmail}.`;
      inquiryStatus.append(fallback);
    };

    inquiryForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null = null;
      fields.forEach((field) => {
        const message = validateField(field);
        setFieldError(field, message);
        if (message && !firstInvalid) firstInvalid = field;
      });
      if (firstInvalid) {
        firstInvalid.focus();
        inquiryStatus.textContent = 'Please check the highlighted fields.';
        return;
      }

      submitting = true;
      inquirySubmit.disabled = true;
      inquirySubmit.setAttribute('aria-busy', 'true');
      submitLabel.hidden = true;
      submitLoading.hidden = false;
      inquiryStatus.textContent = 'Sending your inquiry…';

      const payload = Object.fromEntries(new FormData(inquiryForm).entries());
      try {
        const response = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data.ok === true) {
          inquiryForm.hidden = true;
          inquiryStatus.textContent = '';
          inquirySuccess.hidden = false;
          inquirySuccess.focus();
          return;
        }

        showFailure(
          typeof data.error === 'string' ? data.error : 'We could not send your inquiry. Please try again.',
          data.fallbackEmail,
        );
      } catch {
        showFailure('We could not reach the inquiry service right now.');
      } finally {
        submitting = false;
        inquirySubmit.disabled = false;
        inquirySubmit.removeAttribute('aria-busy');
        submitLabel.hidden = false;
        submitLoading.hidden = true;
      }
    });
  }
</script>
