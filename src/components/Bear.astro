---
/**
 * Bear — Geometric bear emblem for PersianBearStudio.
 *
 * A minimal, sophisticated bear mark built from simple geometric primitives:
 *   - Two rounded "ear" circles
 *   - A rounded "head" squircle
 *   - Two small eye dots
 *   - A subtle snout line
 *   - A single orange accent stroke through the brow (the brand spark)
 *
 * Properties:
 *   - `size`: pixel size of the rendered SVG (default 32)
 *   - `variant`: 'mono' (default, primary text color) | 'accent' (orange)
 *               | 'bi-color' (text body + orange brow accent)
 *   - `animated`: if true, the SVG path strokes draw themselves in on mount.
 *                Use only for hero / large displays. Default false.
 *   - `class`: extra classes for layout / sizing.
 *
 * The mark is a single SVG so it works as logo, favicon, and small nav icon
 * without any rasterization. Stroke-based for crispness at any size.
 */
export interface Props {
  size?: number | string;
  variant?: 'mono' | 'accent' | 'bi-color';
  animated?: boolean;
  class?: string;
  title?: string;
}

const {
  size = 32,
  variant = 'bi-color',
  animated = false,
  class: className = '',
  title = 'PersianBearStudio emblem',
} = Astro.props;

const computedClass = [
  'bear-mark',
  animated ? 'bear-mark--animated' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

// Color choices
const stroke =
  variant === 'accent'
    ? 'var(--color-accent)'
    : 'var(--color-text-primary)';
const accentStroke = 'var(--color-accent)';

// viewBox 64x64 keeps primitives aligned to whole / half pixels.
---

<svg
  class={computedClass}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  {/* Left ear */}
  <circle
    cx="18"
    cy="16"
    r="7"
    stroke={stroke}
    stroke-width="2"
    stroke-linecap="round"
  />
  {/* Right ear */}
  <circle
    cx="46"
    cy="16"
    r="7"
    stroke={stroke}
    stroke-width="2"
    stroke-linecap="round"
  />
  {/* Inner left ear (accent dot if bi-color) */}
  <circle
    cx="18"
    cy="16"
    r="2.5"
    fill={variant === 'bi-color' ? accentStroke : stroke}
    opacity="0.85"
  />
  {/* Inner right ear */}
  <circle
    cx="46"
    cy="16"
    r="2.5"
    fill={variant === 'bi-color' ? accentStroke : stroke}
    opacity="0.85"
  />
  {/* Head: rounded square (squircle), 40x40 centered */}
  <rect
    x="12"
    y="18"
    width="40"
    height="40"
    rx="14"
    ry="14"
    stroke={stroke}
    stroke-width="2"
  />
  {/* Eyes (two small dots, evenly spaced) */}
  <circle cx="25" cy="36" r="2" fill={stroke} />
  <circle cx="39" cy="36" r="2" fill={stroke} />
  {/* Snout line */}
  <path
    d="M28 47 L36 47"
    stroke={stroke}
    stroke-width="2"
    stroke-linecap="round"
  />
  {/* Brow accent — the brand spark — only for bi-color */}
  {variant === 'bi-color' && (
    <line
      x1="22"
      y1="27"
      x2="42"
      y2="27"
      stroke={accentStroke}
      stroke-width="2"
      stroke-linecap="round"
    />
  )}
  {variant === 'accent' && (
    <line
      x1="22"
      y1="27"
      x2="42"
      y2="27"
      stroke={accentStroke}
      stroke-width="2"
      stroke-linecap="round"
    />
  )}
</svg>

<style>
  /* Animate strokes drawing on when `.bear-mark--animated` is applied.
     Browsers without dash support degrade to static (still correct). */
  .bear-mark--animated circle,
  .bear-mark--animated rect,
  .bear-mark--animated path,
  .bear-mark--animated line {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: bear-draw 1.4s var(--ease-out) forwards;
  }
  .bear-mark--animated circle:nth-of-type(1) { animation-delay: 100ms; }
  .bear-mark--animated circle:nth-of-type(2) { animation-delay: 200ms; }
  .bear-mark--animated rect { animation-delay: 300ms; }
  .bear-mark--animated circle:nth-of-type(3),
  .bear-mark--animated circle:nth-of-type(4) {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    animation-duration: 400ms;
    animation-delay: 800ms;
  }
  .bear-mark--animated path { animation-delay: 1000ms; }
  .bear-mark--animated line { animation-delay: 1100ms; }

  @keyframes bear-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bear-mark--animated circle,
    .bear-mark--animated rect,
    .bear-mark--animated path,
    .bear-mark--animated line {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
