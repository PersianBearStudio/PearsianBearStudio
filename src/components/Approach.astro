---
/**
 * Approach — Four-stage studio workflow.
 *
 *  - Horizontal sequence on desktop, vertical on mobile.
 *  - Numbers (01–04).
 *  - Animated top line that grows across each stage on hover.
 *  - General workflow principles, not claims about completed client projects.
 *  - All text bilingual via <I18n>.
 */
import I18n from './I18n.astro';

const stages = [
  { num: '01', titleKey: 'stage1Title', bodyKey: 'stage1Body' },
  { num: '02', titleKey: 'stage2Title', bodyKey: 'stage2Body' },
  { num: '03', titleKey: 'stage3Title', bodyKey: 'stage3Body' },
  { num: '04', titleKey: 'stage4Title', bodyKey: 'stage4Body' },
] as const;
---

<section class="section approach" id="approach" aria-labelledby="approach-heading">
  <div class="container">
    <header class="approach-header" data-reveal>
      <p class="eyebrow"><I18n k="approachEyebrow" /></p>
      <h2 class="approach-heading" id="approach-heading">
        <I18n k="approachHeading" />
        <span class="heading-rule" aria-hidden="true"></span>
      </h2>
      <p class="approach-sub">
        <I18n k="approachSub" />
      </p>
    </header>

    <ol class="stages" data-reveal-stagger>
      {
        stages.map((stage, i) => (
          <li class="stage" data-reveal style={`--stagger-index: ${i};`}>
            <div class="stage-head">
              <span class="index-num stage-num">{stage.num}</span>
              <h3 class="stage-title"><I18n k={stage.titleKey} /></h3>
            </div>
            <p class="stage-body"><I18n k={stage.bodyKey} /></p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach-header {
    max-width: 50ch;
    margin-block-end: var(--space-16);
  }

  .approach-heading {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    margin-block-start: var(--space-4);
  }

  .approach-sub {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .stages {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  /* Desktop: horizontal sequence */
  @media (min-width: 800px) {
    .stages {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .stage:last-child {
      border-inline-end: none;
    }
    .stage {
      border-inline-end: 1px solid var(--color-border);
    }
  }

  .stage {
    position: relative;
    padding-block: var(--space-8);
    padding-inline-end: var(--space-4);
    border-top: 1px solid var(--color-border);
    transition: padding-inline-start var(--duration-base) var(--ease-out);
  }

  .stage::after {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    height: 1px;
    width: 0;
    background: var(--color-accent);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .stage:hover::after {
    width: 100%;
  }

  .stage:hover {
    padding-inline-start: var(--space-3);
  }

  .stage-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  .stage-num {
    color: var(--color-accent);
  }

  .stage-title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .stage:hover .stage-title {
    color: var(--color-accent);
  }

  .stage-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 32ch;
  }

  /* Mobile: vertical, but with a left "rail" */
  @media (max-width: 799px) {
    .stage {
      padding-inline-start: var(--space-4);
      border-inline-start: 1px solid var(--color-border);
      margin-inline-start: 0;
    }
    .stage::after {
      top: -1px;
      bottom: auto;
      height: 1px;
      width: 0;
    }
    .stage:hover::after {
      width: 100%;
    }
  }
</style>
