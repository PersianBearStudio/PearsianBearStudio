{
  "name": "persianbearstudio",
  "version": "1.0.0",
  "type": "module",
  "description": "PersianBearStudio — independent web development studio website (Cloudflare Worker)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "dev:worker": "npm run build && wrangler dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "test:smoke": "node scripts/smoke-test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "verify": "npm run typecheck && npm run build && npm run test:smoke && npm audit --omit=dev",
    "audit": "npm audit --omit=dev",
    "astro": "astro",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "license": "UNLICENSED",
  "private": true
}
